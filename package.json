{
  "name": "staychat-os",
  "version": "1.0.0",
  "description": "StayChat OS — WhatsApp-Native Hotel Management SaaS",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/db/seed.js",
    "icons": "node scripts/generate-icons.js",
    "check": "node server/db/check.js",
    "migrate": "node server/db/migrate.js",
    "rebuild": "npm rebuild better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "nodemailer": "^10.0.10",
    "qrcode-generator": "^1.4.4",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
