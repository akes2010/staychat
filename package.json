{
  "name": "staychat-os",
  "version": "1.0.0",
  "description": "StayChat OS — WhatsApp-Native Hotel Management SaaS",
  "author": {
    "name": "StayChat",
    "email": "support@staychatos.com"
  },
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/db/seed.js",
    "icons": "node scripts/generate-icons.js",
    "desktop": "electron .",
    "desktop:rebuild": "electron-builder install-app-deps",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "package:desk": "node scripts/build-desk-package.js",
    "check": "node server/db/check.js",
    "migrate": "node server/db/migrate.js",
    "test": "node scripts/run-tests.js",
    "test:fast": "node scripts/run-tests.js --fast",
    "smoke": "node scripts/deploy-smoke.js",
    "rebuild": "npm rebuild better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "11.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.11",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "nodemailer": "^10.0.10",
    "qrcode-generator": "^1.4.4",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "better-sqlite3@11.3.0": true
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.staychat.desk",
    "productName": "StayChat Desk",
    "copyright": "© StayChat",
    "directories": {
      "output": "dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "!public/browser-shots/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StayChat Desk"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "executableName": "staychat-desk",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icons-linux",
      "synopsis": "Hotel management system — local desktop edition"
    }
  }
}
