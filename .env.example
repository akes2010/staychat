# ═══════════════════════════════════════════════════════════════════════════════
# StayChat OS — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_VERSION=1.0.0

# ── Security — REQUIRED IN PRODUCTION ────────────────────────────────────────
# Generate strong random secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These are MANDATORY in production — server will refuse to start without them
JWT_ACCESS_SECRET=generate_a_48_byte_random_string_here
JWT_REFRESH_SECRET=a_different_48_byte_random_string_here

# Cookie signing secret — REQUIRED IN PRODUCTION (server refuses to start
# without it, same as the JWT secrets above).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=another_random_secret_for_cookie_signing

# ── Credential encryption ────────────────────────────────────────────────────
# Encrypts external API credentials (payment/SMS/email keys, etc.) at rest with
# AES-256-GCM. MANDATORY in production — server refuses to start without it.
# Preferred: a 64-char hex string (32 bytes), used directly as the key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Any other string is accepted as a passphrase and stretched with scrypt.
# Changing this after credentials are saved makes existing ones undecryptable.
CREDENTIALS_ENCRYPTION_KEY=generate_a_64_char_hex_string_here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# Example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
# Leave unset to allow same-origin only (recommended for container deployments).
CORS_ORIGIN=

# ── Cookie Domain ────────────────────────────────────────────────────────────
# Set to your domain for cross-subdomain cookie sharing (optional)
# COOKIE_DOMAIN=.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Directory for SQLite database file. MOUNT THIS AS A PERSISTENT VOLUME!
DATA_DIR=./data

# ── Transactional Email (Optional — app works without it) ────────────────────
# Provider 1: Resend (recommended; free tier 100/day). https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="StayChat OS <onboarding@resend.dev>"   # use your verified domain in prod
#
# Provider 2: any SMTP server (needs `npm i nodemailer`)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="StayChat OS <no-reply@example.com>"
#
# With neither set, email is disabled: sends log and no-op (never an error).
#
# ── Subscription scheduler ─────────────────────────────────────────────────
# Renewal reminders (7d/1d before expiry) + expiry sweeps run at boot and then
# hourly. Adjust interval in minutes if needed.
# SCHEDULER_INTERVAL_MINUTES=60
#
# ── AI Configuration (Optional) ──────────────────────────────────────────────
# Anthropic Claude API for AI Receptionist
# Platform-wide AI keys power the AI Receptionist for hotels that have not
# configured their own provider (Settings → AI). Priority: tenant config →
# these env keys → built-in offline keyword fallback (never breaks).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
#
# ── Platform Billing / Automated Payments (Optional) ─────────────────────────
# Preferred setup is IN-APP: Super Admin → Billing & Approvals — gateway keys
# are stored encrypted there and can be rotated without a redeploy.
# APP_URL: public base URL used to build gateway redirect/webhook URLs.
# APP_URL=https://app.staychat.io
# PLATFORM_GATEWAY: which gateway to prefer when both keys are set ('stripe' | 'paystack')
# PLATFORM_GATEWAY=stripe

# ── Seed Control ───────────────────────────────────────────────────────────────
# Set to 1 to wipe and re-seed demo data
# FORCE_SEED=1

# Demo account password (change in production!)
# DEMO_PASSWORD=YourSecureDemoPassword123!
#
# Post-seed verification (npm run check / deploy start command):
# false = skip demo-tenant/user verification, check only the core schema.
# For hardened deployments where demo accounts were removed or passwords rotated.
# CHECK_DEMO_USERS=false

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=info (options: debug, info, warn, error)
# Per-request access log on/off (default: on). At 500–1000 concurrent users the
# access stream is ~100–400 lines/s — turn it off if a file shipper or sidecar
# already captures stdout.
# ACCESS_LOG=on

# ── Scale / load tuning (defaults suit most deployments) ───────────────────
# Per-IP API budget per minute. Raise when many staff share ONE egress IP
# (an office NAT'd behind a single router can trip 200/min at shift start).
# RATE_LIMIT_GLOBAL_MAX=200
# Max concurrent WebSocket connections per tenant (one per open tab).
# Default 2000 comfortably covers a 500–1000 seat hotel.
# WS_MAX_CLIENTS_PER_TENANT=2000
# Worker threads for bcrypt hashing/verifying. Login bursts are CPU-bound
# (~350ms per hash); workers keep that off the request thread so the API stays
# responsive while staff sign in. Default: cpus-2 capped at 6.
# BCRYPT_WORKERS=6
